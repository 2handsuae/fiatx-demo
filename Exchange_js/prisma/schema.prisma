model Clearing {
  id             String         @id @default(uuid())
  clearingNo     String         @unique @default("TEMP")
  clearingType   String
  sourceType     String
  sourceId       String
  outAssetId     String
  outAmount      Decimal
  inAssetId      String
  inAmount       Decimal
  feeAssetId     String
  feeAmount      Decimal
  feeMethod      String         @default("CONFIGURED_FEE")
  outPayoutId    String?
  inPayinId      String?
  clearingStatus String         @default("OPEN")
