model InternalTransaction {
  id          String   @id @default(uuid())
  internalTxNo String  @unique
  type        String
  status      String
  approvalStatus String @default("APPROVED")
  makerUserId String?
  checkerUserId String?
  checkedAt DateTime?
  reviewReason String?
  sourceType  String
  sourceId    String
  sourceNo    String?
  ownerType   String
  ownerId     String
  ownerNo     String?
  assetId     String
  amount      Decimal
  feeAmount   Decimal  @default(0)
  netAmount   Decimal
  fromWalletId String?
  fromAddress String?
  fromIban    String?
  toWalletId  String?
  toAddress   String?
  toIban      String?
  referenceNo String?
  statusHistory String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
