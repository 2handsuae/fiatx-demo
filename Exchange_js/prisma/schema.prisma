  outstandings          Outstanding[]

  @@unique([settlementId, assetId])
  @@index([settlementId])
  @@index([assetId])
  @@index([internalTransactionId])
  @@index([status])
  @@map("outstanding_settlement_items")
}

model SwapTransactionAuditLog {
