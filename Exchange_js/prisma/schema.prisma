  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, quoteAssetCode])
  @@index([status])
  @@map("asset_valuation_rates")
}

model AcctEvent {
  id                          String                  @id @default(uuid())
  eventCode                   String                  @unique
  entityType                  String
  ownerScope                  String
  assetType                   String
  triggerType                 String
  postingMode                 String
  clearingMode                String
  postingReversalOfEventCode  String?
  clearingReversalOfEventCode String?
  isActive                    Boolean                 @default(true)
  description                 String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  fromStatus                  String?
  toStatus                    String?
  triggerKey                  String?
  clearingTemplateCode        String?
  postingReversalEvent        AcctEvent?              @relation("PostingReversal", fields: [postingReversalOfEventCode], references: [eventCode])
  reversalOfPosting           AcctEvent[]             @relation("PostingReversal")
  clearingReversalEvent       AcctEvent?              @relation("ClearingReversal", fields: [clearingReversalOfEventCode], references: [eventCode])
  reversalOfClearing          AcctEvent[]             @relation("ClearingReversal")
