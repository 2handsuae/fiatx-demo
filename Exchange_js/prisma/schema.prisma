generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  userNo    String   @unique @default("TEMP")
  email     String   @unique
  password  String
  role                String
  status              String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  userRoles           UserRole[]
  adminInvitations    AdminUserInvitation[]

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  method          String
  path            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model AdminUserInvitation {
  id              String    @id @default(uuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_user_invitations")
}

model CustomerMain {
  id                 String    @id @default(uuid())
  customerNo         String    @unique @default("TEMP")
  email              String?   @unique
  phone              String?   @unique
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  firstName          String?
  lastName           String?
  companyName        String?
  passwordHash       String?
  passwordUpdatedAt  DateTime?
  riskScore          Int?
  riskLevel          String?
  riskUpdatedAt      DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  locale             String?
  timezone           String?
  termsAcceptedAt    DateTime?
  customerType       String    @default("UNKNOWN") // INDIVIDUAL, CORPORATE
  cddStatus          String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, PENDING_REVIEW, APPROVED, REJECTED, EXPIRED
  amlRiskTier        String    @default("LOW") // LOW, MEDIUM, HIGH
  eddRequired        Boolean   @default(false)
  eddStatus          String    @default("NOT_REQUIRED") // NOT_REQUIRED, REQUIRED, IN_PROGRESS, PENDING_MLRO, APPROVED, REJECTED, EXPIRED
  complianceStatus   String    @default("NONE") // NONE, IN_PROGRESS, ACTIVE, RESTRICTED, BLOCKED, EXPIRED
  cddDocumentExpiresAt DateTime?
  finalApprovalStatus String   @default("NOT_REQUIRED") // NOT_REQUIRED, PENDING, APPROVED, REJECTED
  finalApprovalReason String?
  finalApprovalReviewerId String?
  finalApprovalReviewedAt DateTime?
  nextReviewAt       DateTime?
  currentCddCaseId   String?
  currentEddCaseId   String?
  investorClassification String @default("RETAIL") // RETAIL, QUALIFIED, INSTITUTIONAL
  investorClassificationSource String @default("CDD") // CDD, ADMIN_OVERRIDE
  investorClassificationUpdatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  depositTransactions  DepositTransaction[]
  swapTransactions     SwapTransaction[]
  withdrawTransactions WithdrawTransaction[]
  payouts              Payout[]
  payins               Payin[]
  cddCases             CddCase[]
  eddCases             EddCase[]
  corporateProfile     CorporateProfile?
  uboProfiles          UboProfile[]
  onboardingAuditLogs  OnboardingAuditLog[]
  complianceSessions   ComplianceSession[]
  cddCaseReports       CddCaseReport[]
  eddCaseReports       EddCaseReport[]

  @@map("customer_main")
}

model CddCase {
  id               String   @id @default(uuid())
  caseNo            String   @unique @default("TEMP")
  customerId        String
  customerType      String   @default("INDIVIDUAL")
  subjectKind       String   @default("INDIVIDUAL_CUSTOMER") // INDIVIDUAL_CUSTOMER, CORPORATE_ENTITY, UBO_PERSON
  subjectRefId      String   @default("")
  journeyId         String   @default("")
  status            String   @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  reviewerRole      String?
  reviewerDecision  String?
  decisionReason    String?
  requiresEdd       Boolean  @default(false)
  riskScore         Int?
  riskLevel         String?
  screeningSummary  String?
  pepHit            Boolean  @default(false)
  sanctionsHit      Boolean  @default(false)
  inputData         String? // JSON payload
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          CustomerMain @relation(fields: [customerId], references: [id])
  eddCases          EddCase[]
  reports           CddCaseReport[]

  @@index([customerId, status])
  @@index([customerId, journeyId])
  @@index([subjectKind, subjectRefId])
  @@map("cdd_cases")
}

model EddCase {
  id               String   @id @default(uuid())
  caseNo           String   @unique @default("TEMP")
  customerId       String
  cddCaseId        String?
  subjectKind      String   @default("INDIVIDUAL_CUSTOMER") // INDIVIDUAL_CUSTOMER, CORPORATE_ENTITY, UBO_PERSON
  subjectRefId     String   @default("")
  journeyId        String   @default("")
  status           String   @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED
  submittedAt      DateTime?
  mlroReviewedAt   DateTime?
  mlroReviewerId   String?
  mlroDecision     String?
  decisionReason   String?
  sourceOfFunds    String?
  sourceOfWealth   String?
  inputData        String? // JSON payload
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer         CustomerMain @relation(fields: [customerId], references: [id])
  cddCase          CddCase?     @relation(fields: [cddCaseId], references: [id])
  reports          EddCaseReport[]

  @@index([customerId, status])
  @@index([cddCaseId])
  @@index([customerId, journeyId])
  @@index([subjectKind, subjectRefId])
  @@map("edd_cases")
}

model CorporateProfile {
  id                      String   @id @default(uuid())
  customerId              String   @unique
  companyName             String
  registrationNo          String
  incorporationCountry    String
  registeredAddress       String?
  licenseType             String?
  licenseNumber           String?
  authorizedSignatoryName String?
  authorizedSignatoryTitle String?
  documents               String? // JSON array
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  customer                CustomerMain @relation(fields: [customerId], references: [id])

  @@map("corporate_profiles")
}

model UboProfile {
  id               String   @id @default(uuid())
  customerId       String
  fullName         String
  ownershipPercent Decimal?
  nationality      String?
  idNumber         String?
  pepFlag          Boolean  @default(false)
  status           String   @default("PENDING") // PENDING, CDD_IN_PROGRESS, CDD_APPROVED, EDD_IN_PROGRESS, EDD_APPROVED, REJECTED
  documents        String? // JSON array
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer         CustomerMain @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("ubo_profiles")
}

model ComplianceSession {
  id                String   @id @default(uuid())
  customerId        String
  caseType          String // CDD, EDD
  caseId            String
  provider          String   @default("MOCK")
  providerSessionId String   @unique
  qrCodeUrl         String
  status            String   @default("PENDING") // PENDING, COMPLETED, EXPIRED, FAILED
  rawPayload        String?
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          CustomerMain @relation(fields: [customerId], references: [id])

  @@index([customerId, caseType, caseId])
  @@index([status, expiresAt])
  @@map("compliance_sessions")
}

model CddCaseReport {
  id                String   @id @default(uuid())
  customerId        String
  cddCaseId         String
  provider          String   @default("MOCK")
  providerSessionId String?
  rawPayload        String?
  normalizedPayload String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          CustomerMain @relation(fields: [customerId], references: [id])
  cddCase           CddCase      @relation(fields: [cddCaseId], references: [id])

  @@index([customerId, cddCaseId])
  @@index([provider, providerSessionId])
  @@map("cdd_case_reports")
}

model EddCaseReport {
  id                String   @id @default(uuid())
  customerId        String
  eddCaseId         String
  provider          String   @default("MOCK")
  providerSessionId String?
  rawPayload        String?
  normalizedPayload String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          CustomerMain @relation(fields: [customerId], references: [id])
  eddCase           EddCase      @relation(fields: [eddCaseId], references: [id])

  @@index([customerId, eddCaseId])
  @@index([provider, providerSessionId])
  @@map("edd_case_reports")
}

model KytCase {
  id                    String          @id @default(uuid())
  caseNo                String          @unique @default("TEMP")
  sourceType            String
  sourceId              String
  screeningStage        String
  ownerType             String
  ownerId               String?
  assetId               String
  provider              String          @default("MOCK")
  providerCaseId        String?
  status                String          @default("PENDING")
  riskScore             Int?
  checkedAt             DateTime?
  latestRawPayload      String?
  latestNormalizedPayload String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  reports               KytCaseReport[]

  @@unique([sourceType, sourceId, screeningStage])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([provider, providerCaseId])
  @@map("kyt_cases")
}

model KytCaseReport {
  id                    String   @id @default(uuid())
  kytCaseId             String
  sourceType            String
  sourceId              String
  screeningStage        String
  provider              String   @default("MOCK")
  providerCaseId        String?
  rawPayload            String?
  normalizedPayload     String?
  receivedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  kytCase               KytCase  @relation(fields: [kytCaseId], references: [id], onDelete: Cascade)

  @@index([kytCaseId])
  @@index([sourceType, sourceId, screeningStage])
  @@index([provider, providerCaseId])
  @@index([receivedAt])
  @@map("kyt_case_reports")
}

model TravelRuleCase {
  id                    String                @id @default(uuid())
  caseNo                String                @unique @default("TEMP")
  sourceType            String
  sourceId              String
  ownerType             String
  ownerId               String?
  assetId               String
  provider              String                @default("MOCK")
  providerTransferId    String?
  required              Boolean               @default(false)
  status                String                @default("PENDING")
  counterpartyVasp      String?
  checkedAt             DateTime?
  latestRawPayload      String?
  latestNormalizedPayload String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  reports               TravelRuleCaseReport[]

  @@unique([sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([provider, providerTransferId])
  @@map("travel_rule_cases")
}

model TravelRuleCaseReport {
  id                    String          @id @default(uuid())
  travelRuleCaseId      String
  sourceType            String
  sourceId              String
  provider              String          @default("MOCK")
  providerTransferId    String?
  required              Boolean         @default(false)
  status                String
  counterpartyVasp      String?
  rawPayload            String?
  normalizedPayload     String?
  receivedAt            DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  travelRuleCase        TravelRuleCase  @relation(fields: [travelRuleCaseId], references: [id], onDelete: Cascade)

  @@index([travelRuleCaseId])
  @@index([sourceType, sourceId])
  @@index([provider, providerTransferId])
  @@index([receivedAt])
  @@map("travel_rule_case_reports")
}

model OnboardingAuditLog {
  id         String   @id @default(uuid())
  customerId String
  caseType   String?
  caseId     String?
  action     String
  actorId    String
  actorRole  String
  fromStage  String?
  toStage    String?
  detail     String?
  createdAt  DateTime @default(now())

  customer   CustomerMain @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@map("onboarding_audit_logs")
}

model AuditLogEvent {
  id              String   @id @default(uuid())
  auditNo         String   @unique @default("TEMP")
  triggerType     String
  action          String
  module          String
  entityType      String
  entityId        String?
  entityNo        String?
  entityOwnerType String?
  entityOwnerId   String?
  statusFrom      String?
  statusTo        String?
  actorType       String
  actorId         String
  actorNo         String?
  actorRole       String?
  requestId       String?
  sourceIp        String?
  sourcePlatform  String?
  result          String   @default("SUCCESS")
  reason          String?
  metadata        String?
  beforeData      String?
  afterData       String?
  idempotencyKey  String?  @unique
  payloadDigest   String
  maskVersion     String   @default("v1")
  retainedUntil   DateTime
  entityOwnerNo   String?
  archivedAt      DateTime?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subjectNos      AuditLogSubjectNo[]

  @@index([occurredAt])
  @@index([triggerType, occurredAt])
  @@index([module, occurredAt])
  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([module, entityType, entityId, occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([actorNo, occurredAt])
  @@index([entityOwnerNo, occurredAt])
  @@index([result, occurredAt])
  @@index([retainedUntil])
  @@index([archivedAt])
  @@map("audit_log_events")
}

model AuditEvidencePackage {
  id             String   @id @default(uuid())
  packageNo      String   @unique @default("TEMP")
  exportedByType String
  exportedById   String
  exportedByRole String?
  filterSnapshot String?
  itemCount      Int
  digest         String
  manifest       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@index([exportedByType, exportedById])
  @@map("audit_evidence_packages")
}

model AuditLogSubjectNo {
  id          String        @id @default(uuid())
  eventId     String
  subjectRole String
  subjectType String
  subjectId   String?
  subjectNo   String
  occurredAt  DateTime
  createdAt   DateTime      @default(now())
  event       AuditLogEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([subjectNo, occurredAt])
  @@index([subjectType, subjectNo, occurredAt])
  @@index([eventId])
  @@map("audit_log_subject_nos")
}

model ComplianceAlert {
  id               String                 @id @default(uuid())
  alertNo          String                 @unique @default("TEMP")
  dedupeKey        String                 @unique
  ruleCode         String
  capCode          String?
  severity         String
  status           String                 @default("NEW")
  title            String
  message          String
  sourceModule     String
  sourceType       String
  sourceId         String
  sourceNo         String?
  entityType       String?
  entityId         String?
  entityNo         String?
  ownerType        String?
  ownerId          String?
  ownerNo          String?
  customerId       String?
  customerNo       String?
  firstOccurredAt  DateTime
  lastOccurredAt   DateTime
  dueAt            DateTime
  hitCount         Int                    @default(1)
  assigneeUserId   String?
  assigneeUserNo   String?
  assignedAt       DateTime?
  closedAt         DateTime?
  closeReason      String?
  lastActionById   String?
  lastActionByNo   String?
  lastActionByRole String?
  lastActionAt     DateTime?
  metadata         String?
  retainedUntil    DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  events           ComplianceAlertEvent[]
  primaryIncident  ComplianceIncident?    @relation("PrimaryIncidentAlert")
  incidentLinks    ComplianceIncidentAlert[]

  @@index([status, lastOccurredAt])
  @@index([severity, status, dueAt])
  @@index([ruleCode, lastOccurredAt])
  @@index([sourceType, sourceId, lastOccurredAt])
  @@index([customerNo, lastOccurredAt])
  @@map("compliance_alerts")
}

model ComplianceAlertEvent {
  id             String          @id @default(uuid())
  alertId        String
  eventType      String
  eventAt        DateTime        @default(now())
  actorType      String
  actorId        String
  actorNo        String?
  actorRole      String?
  note           String?
  payload        String?
  sourcePlatform String?
  createdAt      DateTime        @default(now())
  alert          ComplianceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, eventAt])
  @@map("compliance_alert_events")
}

model ComplianceIncident {
  id                String                    @id @default(uuid())
  incidentNo        String                    @unique @default("TEMP")
  status            String                    @default("NEW")
  severity          String
  title             String
  summary           String
  primaryAlertId    String?                   @unique
  primaryAlertNo    String?
  customerId        String?
  customerNo        String?
  entityType        String?
  entityId          String?
  entityNo          String?
  sourceModule      String?
  sourceType        String?
  ownerUserId       String?
  ownerUserNo       String?
  assignedAt        DateTime?
  alertCount        Int                       @default(1)
  firstAlertAt      DateTime
  lastAlertAt       DateTime
  dueAt             DateTime
  resolvedAt        DateTime?
  closedAt          DateTime?
  closeReason       String?
  rootCauseCategory String?
  resolutionSummary String?
  containmentSummary String?
  closureChecklist  String?
  lastActionById    String?
  lastActionByNo    String?
  lastActionByRole  String?
  lastActionAt      DateTime?
  metadata          String?
  retainedUntil     DateTime
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  primaryAlert      ComplianceAlert?          @relation("PrimaryIncidentAlert", fields: [primaryAlertId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  alerts            ComplianceIncidentAlert[]
  events            ComplianceIncidentEvent[]

  @@index([status, lastActionAt])
  @@index([severity, status, dueAt])
  @@index([customerNo, lastActionAt])
  @@index([primaryAlertId])
  @@index([lastAlertAt])
  @@map("compliance_incidents")
}

model ComplianceIncidentAlert {
  id           String             @id @default(uuid())
  incidentId   String
  alertId      String             @unique
  alertNo      String
  relationType String
  linkedAt     DateTime           @default(now())
  linkedByType String
  linkedById   String
  linkedByNo   String?
  linkedByRole String?
  note         String?
  createdAt    DateTime           @default(now())
  incident     ComplianceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  alert        ComplianceAlert    @relation(fields: [alertId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([incidentId, alertId])
  @@index([incidentId, relationType, linkedAt])
  @@index([alertId])
  @@map("compliance_incident_alerts")
}

model ComplianceIncidentEvent {
  id             String             @id @default(uuid())
  incidentId     String
  eventType      String
  eventAt        DateTime           @default(now())
  actorType      String
  actorId        String
  actorNo        String?
  actorRole      String?
  note           String?
  payload        String?
  sourcePlatform String?
  createdAt      DateTime           @default(now())
  incident       ComplianceIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([incidentId, eventAt])
  @@map("compliance_incident_events")
}

model LiquidityProvider {
  id             String                   @id
  name           String
  email          String?                  @unique
  phone          String?
  status         String                   @default("INACTIVE")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  configurations LiquidityConfiguration[]

  @@index([name])
  @@index([status])
  @@map("liquidity_provider")
}

model Asset {
  id                     String                   @id @default(uuid())
  assetNo                String?                  @unique
  type                   String
  code                   String
  network                String?
  decimals               Int
  description            String?
  status                 String                   @default("ACTIVE")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  depositTransactions    DepositTransaction[]
  journalHeaderTemplates JournalHeaderTemplate[]
  journalLines           JournalLine[]
  journals               Journal[]                @relation("BaseAsset")
  fromConfigs            LiquidityConfiguration[] @relation("FromAsset")
  toConfigs              LiquidityConfiguration[] @relation("ToAsset")
  feeConfigs             LiquidityConfiguration[] @relation("FeeAsset")
  customerSwapFromConfigs CustomerSwapRateConfiguration[] @relation("CustomerSwapRateFromAsset")
  customerSwapToConfigs   CustomerSwapRateConfiguration[] @relation("CustomerSwapRateToAsset")
  payins                 Payin[]
  payouts                Payout[]
  swapFromTransactions   SwapTransaction[]        @relation("SwapFromAsset")
  swapToTransactions     SwapTransaction[]        @relation("SwapToAsset")
  swapQuoteFroms         SwapQuote[]              @relation("SwapQuoteFromAsset")
  swapQuoteTos           SwapQuote[]              @relation("SwapQuoteToAsset")
  outstandings           Outstanding[]
  outstandingSettlementItems OutstandingSettlementItem[]
  wallets                Wallet[]
  withdrawTransactions   WithdrawTransaction[]
  internalTransactions   InternalTransaction[]
  internalFunds          InternalFund[]
  walletBalanceSnapshots WalletBalanceSnapshot[]
  walletBalanceEntries   WalletBalanceEntry[]
  valuationRates         AssetValuationRate[]

  @@unique([type, code, network])
  @@map("assets")
}

model Payin {
  id                   String              @id @default(uuid())
  payinNo              String              @unique @default("TEMP")
  depositId            String?
  type                 String              @default("crypto")
  status               String
  toWalletId           String?
  assetId              String
  amount               Decimal
  toAddress            String?
  toIban               String?
  fromWalletId         String?
  fromAddress          String?
  fromIban             String?
  txHash               String?
  confirmations        Int                 @default(0)
  referenceNo          String?
  providerTxnId        String?
  receivedAt           DateTime?
  confirmedAt          DateTime?
  statusHistory        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ownerId              String?             // Added to support relation to CustomerMain
  clearings            Clearing[]          @relation("ClearingInPayin")
  deposit              DepositTransaction? @relation("PayinToDeposit")
  auditLogs            PayinAuditLog[]
  toWallet             Wallet?             @relation("PayinToWallet", fields: [toWalletId], references: [id])
  fromWallet           Wallet?             @relation("PayinFromWallet", fields: [fromWalletId], references: [id])
  asset                Asset               @relation(fields: [assetId], references: [id])
  customer             CustomerMain?       @relation(fields: [ownerId], references: [id])

  @@unique([txHash, assetId, toAddress])
  @@index([depositId])
  @@index([status])
  @@index([assetId])
  @@index([receivedAt])
  @@index([providerTxnId])
  @@index([txHash])
  @@map("payins")
}

model LiquidityConfiguration {
  id             String            @id @default(uuid())
  lpId           String
  fromAssetId    String
  toAssetId      String
  rateSourceType String
  spreadPercent  Decimal           @default(0)
  feePercent     Decimal           @default(0)
  feeFixedAmount Decimal           @default(0)
  feeAssetId     String?
  minFromAmount  Decimal?
  maxFromAmount  Decimal?
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  lp             LiquidityProvider @relation(fields: [lpId], references: [id])
