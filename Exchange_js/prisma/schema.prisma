generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(uuid())
  userNo              String                @unique @default("TEMP")
  email               String                @unique
  password            String
  // Legacy: single-role string kept for JWT backward compatibility.
  // Authoritative RBAC is resolved via userRoles → roles → role_permissions.
  // auth.service.ts includes this field in JWT roleCodes for tokens issued
  // before the roleCodes claim existed. Safe to remove only after all
  // active sessions have been refreshed.
  role                String
  status              String
  failedLoginAttempts Int                   @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  deletedBy           String?
  deleteRequestId     String?
  deleteReason        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  userRoles           UserRole[]
  adminInvitations    AdminUserInvitation[]

  @@index([deletedAt])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  method          String
  path            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model AdminUserInvitation {
  id              String    @id @default(uuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  workflowType    String?
  workflowNo      String?
  traceId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([traceId])
  @@map("admin_user_invitations")
}

model CustomerMain {
  id                              String    @id @default(uuid())
  customerNo                      String    @unique @default("TEMP")
  email                           String?   @unique
  phone                           String?   @unique
  emailVerifiedAt                 DateTime?
  phoneVerifiedAt                 DateTime?
  firstName                       String?
  lastName                        String?
  companyName                     String?
  passwordHash                    String?
  passwordUpdatedAt               DateTime?
  riskScore                       Int?
  riskLevel                       String?
  riskUpdatedAt                   DateTime?
  failedLoginCount                Int       @default(0)
  lockedUntil                     DateTime?
  lastLoginAt                     DateTime?
  lastLoginIp                     String?
  locale                          String?
  timezone                        String?
  termsAcceptedAt                 DateTime?
  customerType                    String    @default("UNKNOWN") // INDIVIDUAL, CORPORATE(legacy disabled in current onboarding)
  onboardingStatus                String    @default("NONE") // NONE, PENDING_VERIFICATION, FINAL_APPROVAL, APPROVED, REJECTED, WITHDRAWN
  verificationProvider            String?
  verificationSubstatus           String?
  verificationCustomerActionRequired Boolean   @default(false)
  verificationCanContinue         Boolean   @default(false)
  verificationLatestEventType     String?
  verificationLatestEventAt       DateTime?
  sumsubApplicantId               String?   @unique
  sumsubCurrentLevelName          String?
  sumsubLatestReviewId            String?
  sumsubLatestAttemptId           String?
  sumsubExperiencedLevel2         Boolean   @default(false)
  onboardingTraceId               String?
  operatingStatus                 String    @default("INACTIVE") // INACTIVE, ACTIVE
  restrictionStatus               String    @default("CLEAR") // CLEAR, RESTRICTED
  restrictionCaseId               String?
  restrictionReason               String?
  restrictionSetAt                DateTime?
  restrictionReleasedAt           DateTime?
  amlRiskTier                     String    @default("LOW") // LOW, MEDIUM, HIGH
  eddRequired                     Boolean   @default(false)
  complianceHoldStatus            String    @default("ACTIVE") // ACTIVE, FROZEN
  complianceHoldCaseId            String?
  complianceHoldReason            String?
  complianceHoldSetAt             DateTime?
  complianceHoldReleasedAt        DateTime?
  cddDocumentExpiresAt            DateTime?
  // ─── renamed 2026-04-09 Wave 3 ─────────────────
  latestRiskApprovalId            String?   @unique
  latestRiskApprovalStatus        String?

  // ─── Wave 3 new ──────────────────────────────
  riskTier                        String    @default("LOW")
  riskTierUpdatedAt               DateTime?
  pepStatus                       String    @default("NONE")
  pepConfirmedAt                  DateTime?
  latestRiskAssessmentId          String?

  nextReviewAt                    DateTime?
  activePeriodicReviewCycleId     String?   @unique
  periodicReviewOverdueAt         DateTime?
  periodicReviewOverdueReason     String?
  latestDecisionRecordId          String?
  investorClassification          String    @default("RETAIL") // RETAIL, QUALIFIED, INSTITUTIONAL
  investorClassificationSource    String    @default("CDD") // CDD, ADMIN_OVERRIDE
  investorClassificationUpdatedAt DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  // Relations
  depositTransactions       DepositTransaction[]
  swapTransactions          SwapTransaction[]
  withdrawTransactions      WithdrawTransaction[]
  payouts                   Payout[]
  payins                    Payin[]
  inboundTransferSignals    InboundTransferSignal[]
  cddResponses              CddResponse[]
  eddResponses              EddResponse[]
  corporateProfile          CorporateProfile?
  uboProfiles               UboProfile[]
  onboardingAuditLogs       OnboardingAuditLog[]
  workflowDecisionRecords   WorkflowDecisionRecord[]
  complianceSessions        ComplianceSession[]
  cddResponseReports        CddResponseReport[]
  eddResponseReports        EddResponseReport[]
  latestRiskApproval        ApprovalCase?            @relation("CustomerLatestRiskApproval", fields: [latestRiskApprovalId], references: [id], onDelete: SetNull)
  activePeriodicReviewCycle PeriodicReviewCycle?     @relation("CustomerActivePeriodicReviewCycle", fields: [activePeriodicReviewCycleId], references: [id], onDelete: SetNull)
  periodicReviewCycles      PeriodicReviewCycle[]    @relation("CustomerPeriodicReviewCycles")
  materialHoldings          CustomerMaterialHolding[] @relation("CustomerMaterialHoldings")
  materialRefreshCycles     MaterialRefreshCycle[]   @relation("CustomerMaterialRefreshCycles")
  riskAssessments           ClientRiskAssessment[]   @relation("CustomerRiskAssessments")

  @@index([complianceHoldStatus])
  @@index([latestRiskApprovalStatus])
  @@index([activePeriodicReviewCycleId])
  @@map("customer_main")
}

model CddResponse {
  id                    String    @id @default(uuid())
  caseNo                String    @unique @default("TEMP")
  customerId            String
  customerType          String    @default("INDIVIDUAL")
  subjectKind           String    @default("INDIVIDUAL_CUSTOMER") // INDIVIDUAL_CUSTOMER, CORPORATE_ENTITY, UBO_PERSON
  subjectRefId          String    @default("")
  journeyId             String    @default("")
  workflow              String    @default("ONBOARDING")
  periodicReviewCycleId String?
  status                String    @default("CREATED") // CREATED, RECEIVED, FINAL
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewerId            String?
  reviewerRole          String?
  reviewerDecision      String?
  decisionReason        String?
  requiresEdd           Boolean   @default(false)
  riskScore             Int?
  riskLevel             String?
  screeningSummary      String?
  pepHit                Boolean   @default(false)
  sanctionsHit          Boolean   @default(false)
  inputData             String? // JSON payload
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer            CustomerMain         @relation(fields: [customerId], references: [id])
  eddResponses        EddResponse[]
  reports             CddResponseReport[]
  periodicReviewCycle PeriodicReviewCycle? @relation("PeriodicReviewCycleCddResponses", fields: [periodicReviewCycleId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([customerId, journeyId])
  @@index([workflow, status])
  @@index([periodicReviewCycleId])
  @@index([subjectKind, subjectRefId])
  @@map("cdd_responses")
}

model EddResponse {
  id                    String    @id @default(uuid())
  caseNo                String    @unique @default("TEMP")
  customerId            String
  cddResponseId         String?
  subjectKind           String    @default("INDIVIDUAL_CUSTOMER") // INDIVIDUAL_CUSTOMER, CORPORATE_ENTITY, UBO_PERSON
  subjectRefId          String    @default("")
  journeyId             String    @default("")
  workflow              String    @default("ONBOARDING")
  periodicReviewCycleId String?
  status                String    @default("CREATED") // CREATED, RECEIVED, FINAL
  submittedAt           DateTime?
  mlroReviewedAt        DateTime?
  mlroReviewerId        String?
  mlroDecision          String?
  decisionReason        String?
  sourceOfFunds         String?
  sourceOfWealth        String?
  inputData             String? // JSON payload
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer            CustomerMain         @relation(fields: [customerId], references: [id])
  cddResponse         CddResponse?         @relation(fields: [cddResponseId], references: [id])
  reports             EddResponseReport[]
  periodicReviewCycle PeriodicReviewCycle? @relation("PeriodicReviewCycleEddResponses", fields: [periodicReviewCycleId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([cddResponseId])
  @@index([customerId, journeyId])
  @@index([workflow, status])
  @@index([periodicReviewCycleId])
  @@index([subjectKind, subjectRefId])
  @@map("edd_responses")
}

model PeriodicReviewCycle {
  id                     String    @id @default(uuid())
  cycleNo                String    @unique @default("TEMP")
  customerId             String
  status                 String    @default("PENDING_CDD_INPUT") // PENDING_CDD_INPUT, CDD_UNDER_REVIEW, PENDING_EDD_INPUT, EDD_UNDER_REVIEW, CLEARED, REJECTED
  dueAt                  DateTime
  triggeredAt            DateTime?
  clearedAt              DateTime?
  rejectedAt             DateTime?
  currentCddResponseId   String?
  currentEddResponseId   String?
  primaryAlertId         String?
  primaryIncidentId      String?
  latestDecisionRecordId String?
  resolutionReason       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  customer       CustomerMain  @relation("CustomerPeriodicReviewCycles", fields: [customerId], references: [id], onDelete: Cascade)
  activeCustomer CustomerMain? @relation("CustomerActivePeriodicReviewCycle")
  cddResponses   CddResponse[] @relation("PeriodicReviewCycleCddResponses")
  eddResponses   EddResponse[] @relation("PeriodicReviewCycleEddResponses")

  @@index([customerId, status])
  @@index([status, dueAt])
  @@index([primaryAlertId])
  @@index([primaryIncidentId])
  @@map("periodic_review_cycles")
}

model CorporateProfile {
  id                       String   @id @default(uuid())
  customerId               String   @unique
  companyName              String
  registrationNo           String
  incorporationCountry     String
  registeredAddress        String?
  licenseType              String?
  licenseNumber            String?
  authorizedSignatoryName  String?
  authorizedSignatoryTitle String?
  documents                String? // JSON array
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  customer CustomerMain @relation(fields: [customerId], references: [id])

  @@map("corporate_profiles")
}

model UboProfile {
  id               String   @id @default(uuid())
  customerId       String
  fullName         String
  ownershipPercent Decimal?
  nationality      String?
  idNumber         String?
  pepFlag          Boolean  @default(false)
  status           String   @default("PENDING") // PENDING, CDD_IN_PROGRESS, CDD_APPROVED, EDD_IN_PROGRESS, EDD_APPROVED, REJECTED
  documents        String? // JSON array
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer CustomerMain @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("ubo_profiles")
}

model ComplianceSession {
  id                String    @id @default(uuid())
  customerId        String
  caseType          String // CDD, EDD
  caseId            String
  provider          String    @default("MOCK")
  providerSessionId String    @unique
  qrCodeUrl         String
  status            String    @default("PENDING") // PENDING, COMPLETED, EXPIRED, FAILED
  rawPayload        String?
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer CustomerMain @relation(fields: [customerId], references: [id])

  @@index([customerId, caseType, caseId])
  @@index([status, expiresAt])
  @@map("compliance_sessions")
}

model CddResponseReport {
  id                String   @id @default(uuid())
  customerId        String
  cddResponseId     String
  provider          String   @default("MOCK")
  providerSessionId String?
  rawPayload        String?
  normalizedPayload String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer    CustomerMain @relation(fields: [customerId], references: [id])
  cddResponse CddResponse  @relation(fields: [cddResponseId], references: [id])

  @@index([customerId, cddResponseId])
  @@index([provider, providerSessionId])
  @@map("cdd_response_reports")
}

model EddResponseReport {
  id                String   @id @default(uuid())
  customerId        String
  eddResponseId     String
  provider          String   @default("MOCK")
  providerSessionId String?
  rawPayload        String?
  normalizedPayload String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer    CustomerMain @relation(fields: [customerId], references: [id])
  eddResponse EddResponse  @relation(fields: [eddResponseId], references: [id])

  @@index([customerId, eddResponseId])
  @@index([provider, providerSessionId])
  @@map("edd_response_reports")
}

model KytCase {
  id                      String    @id @default(uuid())
  caseNo                  String    @unique @default("TEMP")
  sourceType              String
  sourceId                String
  screeningStage          String
  ownerType               String
  ownerId                 String?
  assetId                 String
  provider                String    @default("MOCK")
  providerCaseId          String?
  status                  String    @default("PENDING")
  riskScore               Int?
  checkedAt               DateTime?
  latestRawPayload        String?
  latestNormalizedPayload String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  reports KytCaseReport[]

  @@unique([sourceType, sourceId, screeningStage])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([provider, providerCaseId])
  @@map("kyt_cases")
}

model KytCaseReport {
  id                String   @id @default(uuid())
  kytCaseId         String
  sourceType        String
  sourceId          String
  screeningStage    String
  provider          String   @default("MOCK")
  providerCaseId    String?
  rawPayload        String?
  normalizedPayload String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  kytCase KytCase @relation(fields: [kytCaseId], references: [id], onDelete: Cascade)

  @@index([kytCaseId])
  @@index([sourceType, sourceId, screeningStage])
  @@index([provider, providerCaseId])
  @@index([receivedAt])
  @@map("kyt_case_reports")
}

model TravelRuleCase {
  id                      String    @id @default(uuid())
  caseNo                  String    @unique @default("TEMP")
  sourceType              String
  sourceId                String
  ownerType               String
  ownerId                 String?
  assetId                 String
  provider                String    @default("MOCK")
  providerTransferId      String?
  required                Boolean   @default(false)
  status                  String    @default("PENDING")
  counterpartyVasp        String?
  checkedAt               DateTime?
  latestRawPayload        String?
  latestNormalizedPayload String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  reports TravelRuleCaseReport[]

  @@unique([sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([provider, providerTransferId])
  @@map("travel_rule_cases")
}

model TravelRuleCaseReport {
  id                 String   @id @default(uuid())
  travelRuleCaseId   String
  sourceType         String
  sourceId           String
  provider           String   @default("MOCK")
  providerTransferId String?
  required           Boolean  @default(false)
  status             String
  counterpartyVasp   String?
  rawPayload         String?
  normalizedPayload  String?
  receivedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  travelRuleCase TravelRuleCase @relation(fields: [travelRuleCaseId], references: [id], onDelete: Cascade)

  @@index([travelRuleCaseId])
  @@index([sourceType, sourceId])
  @@index([provider, providerTransferId])
  @@index([receivedAt])
  @@map("travel_rule_case_reports")
}

model OnboardingAuditLog {
  id           String   @id @default(uuid())
  customerId   String
  caseType     String?
  caseId       String?
  action       String
  actorId      String
  actorRole    String
  traceId      String?
  workflowType String?
  workflowId   String?
  workflowNo   String?
  fromStage    String?
  toStage      String?
  detail       String?
  createdAt    DateTime @default(now())

  customer CustomerMain @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([traceId, createdAt])
  @@index([workflowType, workflowNo, createdAt])
  @@map("onboarding_audit_logs")
}

model WorkflowDecisionRecord {
  id                 String    @id @default(uuid())
  customerId         String
  contextType        String // ONBOARDING_CDD, ONBOARDING_EDD
  subjectId          String
  policyVersion      String
  status             String    @default("CREATED") // CREATED, COMPLETED, FAILED
  inputPayload       String?
  inputHash          String
  outputDecision     String?
  recommendedActions String?
  outputs            String?
  reasonCodes        String?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  customer CustomerMain @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([contextType, subjectId, createdAt])
  @@index([status, createdAt])
  @@map("workflow_decision_records")
}

model AuditLogEvent {
  id              String              @id @default(uuid())
  auditNo         String              @unique @default("TEMP")
  triggerType     String
  action          String
  module          String
  entityType      String
  entityId        String?
  entityNo        String?
  traceId         String?
  workflowType    String?
  entityOwnerType String?
  entityOwnerId   String?
  statusFrom      String?
  statusTo        String?
  actorType       String
  actorId         String
  actorNo         String?
  actorRole       String?
  requestId       String?
  sourceIp        String?
  sourcePlatform  String?
  result          String              @default("SUCCESS")
  reason          String?
  metadata        String?
  beforeData      String?
  afterData       String?
  idempotencyKey  String?             @unique
  payloadDigest   String
  maskVersion     String              @default("v1")
  retainedUntil   DateTime
  entityOwnerNo   String?
  archivedAt      DateTime?
  occurredAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  subjectNos      AuditLogSubjectNo[]

  @@index([occurredAt])
  @@index([triggerType, occurredAt])
  @@index([module, occurredAt])
  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([module, entityType, entityId, occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([actorNo, occurredAt])
  @@index([entityOwnerNo, occurredAt])
  @@index([traceId, occurredAt])
  @@index([workflowType, occurredAt])
  @@index([result, occurredAt])
  @@index([retainedUntil])
  @@index([archivedAt])
  @@map("audit_log_events")
}

model AuditEvidencePackage {
  id                       String        @id @default(uuid())
  packageNo                String        @unique @default("TEMP")
  approvalCaseId           String?       @unique
  approvalCaseNo           String?
  exportedByType           String
  exportedById             String
  exportedByNo             String?
  exportedByRole           String?
  status                   String        @default("READY")
  exportMode               String        @default("SELECTION")
  fileName                 String?
  filterSnapshot           String?
  selectedEventIdsSnapshot String?
  itemCount                Int
  digest                   String
  manifest                 String
  packageBody              String?
  deletedAt                DateTime?
  deletedBy                String?
  deleteRequestId          String?
  deleteReason             String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  approvalCase             ApprovalCase? @relation("AuditEvidencePackageApprovalCase", fields: [approvalCaseId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([exportedByType, exportedById])
  @@index([status, createdAt])
  @@index([exportMode, createdAt])
  @@index([approvalCaseId])
  @@index([approvalCaseNo])
  @@index([deletedAt])
  @@map("audit_evidence_packages")
}

// Wave 2-3: Compliance case evidence export. This table is NOT a Wave 1
// delete target (removed from Wave 1 scope per change-delete-ticket-minimalization-design.md).
// Its FK to approval_cases (approvalCaseId) is for the Wave 2-3 evidence export
// approval flow — not part of Wave 1 governed five flows.
model ComplianceCaseEvidencePackage {
  id                      String        @id @default(uuid())
  packageNo               String        @unique @default("TEMP")
  approvalCaseId          String?       @unique
  approvalCaseNo          String?
  exportedByType          String
  exportedById            String
  exportedByNo            String?
  exportedByRole          String?
  status                  String        @default("PENDING_APPROVAL")
  exportMode              String        @default("CASE_SELECTION")
  fileName                String?
  filterSnapshot          String?
  selectedCaseIdsSnapshot String?
  itemCount               Int
  digest                  String
  manifest                String
  packageBody             String?
  deletedAt               DateTime?
  deletedBy               String?
  deleteRequestId         String?
  deleteReason            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  approvalCase            ApprovalCase? @relation("ComplianceCaseEvidencePackageApprovalCase", fields: [approvalCaseId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([exportedByType, exportedById])
  @@index([status, createdAt])
  @@index([approvalCaseId])
  @@index([approvalCaseNo])
  @@index([deletedAt])
  @@map("compliance_case_evidence_packages")
}

model ApprovalCase {
  id                             String                         @id @default(uuid())
  approvalNo                     String                         @unique
  actionType                     String
  entityRef                      String
  createdByUserId                String
  createdByUserNo                String?
  status                         String                         @default("DRAFT")
  executionStatus                String                         @default("NOT_EXECUTED")
  riskLevel                      String                         @default("HIGH")
  checkerRoles                   String
  selectedCheckerRole            String
  allowCancel                    Boolean                        @default(true)
  allowRetry                     Boolean                        @default(true)
  docRef                         String?
  metadataJson                   String                         @default("{}")
  traceId                        String
  workflowType                   String?
  workflowId                     String?
  workflowNo                     String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  submittedAt                    DateTime?
  timeoutAt                      DateTime?
  decidedAt                      DateTime?
  executedAt                     DateTime?
  decisionByUserId               String?
  decisionByUserNo               String?
  decisionByRole                 String?
  decisionReason                 String?
  deletedAt                      DateTime?
  deletedBy                      String?
  deleteRequestId                String?
  deleteReason                   String?
  steps                          ApprovalStep[]
  evidencePackage                AuditEvidencePackage?          @relation("AuditEvidencePackageApprovalCase")
  caseEvidencePackage            ComplianceCaseEvidencePackage? @relation("ComplianceCaseEvidencePackageApprovalCase")
  changeTicketApprovalCase       ChangeTicket?                  @relation("ChangeTicketApprovalCase")
  deleteRequestApprovalCase      DeleteRequest?                 @relation("DeleteRequestApprovalCase")
  latestForCustomerRiskApproval  CustomerMain?                  @relation("CustomerLatestRiskApproval")
  riskAssessments                ClientRiskAssessment[]         @relation("ClientRiskAssessmentApprovalCase")
  linkedRegulatoryGates          RegulatoryGateItem[]           @relation("RegulatoryGateLinkedApproval")
  internalTransactionForApproval InternalTransaction?           @relation("InternalTransactionApprovalCase")

  @@index([actionType, entityRef, status])
  @@index([status, timeoutAt])
  @@index([traceId, createdAt])
  @@index([workflowType, workflowNo, createdAt])
  @@index([deletedAt])
  @@map("approval_cases")
}

model ApprovalStep {
  id                    String       @id @default(uuid())
  approvalCaseId        String
  approvalNo            String?
  stepNo                Int
  status                String       @default("PENDING")
  checkerRoleCandidates String
