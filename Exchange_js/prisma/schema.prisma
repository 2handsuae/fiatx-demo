  amount     Decimal
  refType    String?
  refId      String?
  createdAt  DateTime @default(now()) @map("created_at")
  clearing   Clearing @relation(fields: [clearingId], references: [id], onDelete: Cascade)

  @@unique([clearingId, lineNo])
  @@index([clearingId])
  @@map("clearing_lines")
}
