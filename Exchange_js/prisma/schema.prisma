model ClearingLineTemplate {
  id                 String           @id @default(uuid())
  clearingTemplateId String
  lineNo             Int
  lineType           String
  partyType          String
  partyIdSource      String?
  assetSource        String
  amountSource       String
  refTypeConst       String?
  refIdSource        String?
  memoTemplate       String?
