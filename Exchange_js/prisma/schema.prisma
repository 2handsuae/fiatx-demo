  assetId              String
  amount               Decimal
  feeAmount            Decimal            @default(0)
  netAmount            Decimal
  toWalletId           String?
  toWalletNo           String?
  toAddress            String?
  toIban               String?
  fromWalletId         String?
  fromWalletNo         String?
  fromAddress          String?
  fromIban             String?
  providerTxnId        String?
