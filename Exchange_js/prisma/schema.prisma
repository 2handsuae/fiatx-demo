model SwapQuote {
  id           String           @id @default(uuid())
  quoteNo      String?          @unique
  quoteType    String           @default("FIRM")
  status       String           @default("ACTIVE")
  ownerType    String
  ownerId      String
  ownerNo      String?
  fromAssetId  String
  fromAssetCode String
  toAssetId    String
  toAssetCode  String
  side         String           @default("SELL_BASE")
  amountType   String           @default("EXACT_IN")
  amountIn     Decimal
  currencyIn   String
  amountOut    Decimal
  currencyOut  String
  rateDisplay  Decimal
  rateAllIn    Decimal
  marketRate   Decimal
  spreadPercent Decimal         @default(0)
  spreadBps    Int              @default(0)
  rateSource   String           @default("BINANCE")
  fetchedAt    DateTime
  feeTotal     Decimal          @default(0)
  feeCurrency  String
  feeBreakdown String?
  expiresAt    DateTime
  usedAt       DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  fromAsset    Asset            @relation("SwapQuoteFromAsset", fields: [fromAssetId], references: [id])
  toAsset      Asset            @relation("SwapQuoteToAsset", fields: [toAssetId], references: [id])
  swapTransaction SwapTransaction?

  @@index([ownerType, ownerId])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("swap_quotes")
}

model SwapTransaction {
  id           String                    @id @default(uuid())
  swapNo       String?                   @unique
  quoteId      String?                   @unique @map("quote_id")
  quoteNo      String?
  ownerType    String
  ownerId      String
  ownerNo      String?
  status       String
  fromAssetId  String
  fromAssetCode String?
  fromAmount   Decimal
  toAssetId    String
  toAssetCode   String?
  toAmount     Decimal
  exchangeRate Decimal
  statusHistory String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  completedAt  DateTime?
  auditLogs    SwapTransactionAuditLog[]
  fromAsset    Asset                     @relation("SwapFromAsset", fields: [fromAssetId], references: [id])
  toAsset      Asset                     @relation("SwapToAsset", fields: [toAssetId], references: [id])
  quote        SwapQuote?                @relation(fields: [quoteId], references: [id])
  customer     CustomerMain?             @relation(fields: [ownerId], references: [id])
  outstandings Outstanding[]

  @@index([swapNo])
  @@index([ownerType, ownerId])
  @@index([ownerNo])
  @@index([fromAssetCode])
  @@index([toAssetCode])
  @@index([status])
  @@index([createdAt])
  @@map("swap_transactions")
}

model Outstanding {
  id                String           @id @default(uuid())
  outstandingNo     String?          @unique
  sourceType        String
  sourceId          String
  sourceNo          String?
  ownerType         String
  ownerId           String
  ownerNo           String?
  direction         String
  assetId           String
  assetCode         String?
  amount            Decimal
  status            String           @default("OPEN")
  swapTransactionId String?
  settlementId      String?
  settlementItemId  String?
  lockedAt          DateTime?
  closedAt          DateTime?
  closedByInternalFundId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  asset             Asset            @relation(fields: [assetId], references: [id])
  swapTransaction   SwapTransaction? @relation(fields: [swapTransactionId], references: [id])
  settlement        OutstandingSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  settlementItem    OutstandingSettlementItem? @relation(fields: [settlementItemId], references: [id], onDelete: SetNull)
  closedByInternalFund InternalFund? @relation(fields: [closedByInternalFundId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId, direction])
  @@index([status])
  @@index([ownerType, ownerId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@index([assetId])
  @@index([swapTransactionId])
  @@index([settlementId])
  @@index([settlementItemId])
  @@index([closedByInternalFundId])
  @@map("outstandings")
}

model OutstandingSettlement {
  id                    String                     @id @default(uuid())
  settlementNo          String                     @unique
  sourceType            String                     @default("SWAP")
  rangeStartAt          DateTime?
  cutoffAt              DateTime
  status                String
  requestId             String?                    @unique
  makerUserId           String?
  note                  String?
  totalOutstandingCount Int                        @default(0)
  closedOutstandingCount Int                       @default(0)
  totalAssetCount       Int                        @default(0)
  closedAssetCount      Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  completedAt           DateTime?
  items                 OutstandingSettlementItem[]
  outstandings          Outstanding[]

  @@index([status])
  @@index([sourceType])
  @@index([createdAt])
  @@map("outstanding_settlements")
}

model OutstandingSettlementItem {
  id                    String                @id @default(uuid())
  settlementId          String
  assetId               String
  assetCode             String?
  totalInAmount         Decimal               @default(0)
  totalOutAmount        Decimal               @default(0)
  netAmount             Decimal
  internalType          String?
  internalTransactionId String?
  status                String
  outstandingCount      Int                   @default(0)
  closedOutstandingCount Int                  @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  closedAt              DateTime?
  settlement            OutstandingSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  asset                 Asset                 @relation(fields: [assetId], references: [id])
