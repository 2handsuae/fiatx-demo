  reopenedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  run              SafeguardingRun? @relation("SafeguardingRunBreaks", fields: [runId], references: [id], onDelete: SetNull)

  @@unique([businessDate, sourceType, sourceId])
  @@index([businessDate, status])
  @@index([runId])
  @@index([sourceType, sourceId])
  @@index([withdrawId])
  @@index([payoutId])
  @@map("reconciliation_breaks")
}

model SafeguardingRun {
  id                   String                     @id @default(uuid())
  runNo                String                     @unique @default("TEMP")
  businessDate         String
  status               String                     @default("RUNNING")
  breakCount           Int                        @default(0)
  warningCount         Int                        @default(0)
  traceId              String?
  summaryJson          String?
  startedAt            DateTime                   @default(now())
  finishedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  liabilitySnapshots   LiabilitySnapshot[]
  poolSnapshots        SafeguardingPoolSnapshot[]
  warnings             ReconciliationWarning[]
  fiatStatementImports FiatStatementImport[]
  reconciliationBreaks ReconciliationBreak[]      @relation("SafeguardingRunBreaks")

  @@index([businessDate, createdAt])
  @@index([status, businessDate])
  @@map("safeguarding_runs")
}

model LiabilitySnapshot {
  id              String          @id @default(uuid())
  runId           String
  customerId      String
  customerNo      String?
  assetId         String
  assetCode       String?
  liabilityAmount Decimal         @default(0)
  createdAt       DateTime        @default(now())
  run             SafeguardingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset           Asset           @relation(fields: [assetId], references: [id])

  @@unique([runId, customerId, assetId])
  @@index([runId, assetId])
  @@index([customerId])
  @@map("liability_snapshots")
}

model SafeguardingPoolSnapshot {
  id            String          @id @default(uuid())
  runId         String
  assetId       String
  assetCode     String?
  poolRole      String
  walletId      String?
  accountRef    String?
  sourceType    String?
  sourceRef     String?
  balanceAmount Decimal         @default(0)
  createdAt     DateTime        @default(now())
  run           SafeguardingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset         Asset           @relation(fields: [assetId], references: [id])
  wallet        Wallet?         @relation("SafeguardingPoolSnapshotWallet", fields: [walletId], references: [id], onDelete: SetNull)

  @@index([runId, assetId])
  @@index([assetId, poolRole])
  @@index([walletId])
  @@map("safeguarding_pool_snapshots")
}

model SafeguardingPolicy {
  id                        String   @id @default(uuid())
  policyNo                  String   @unique @default("TEMP")
  assetId                   String
  poolRole                  String
  status                    String   @default("ACTIVE")
  collectionAmountThreshold Decimal?
  collectionMaxAgeMinutes   Int?
  targetMinBalance          Decimal?
  targetMaxBalance          Decimal?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  asset                     Asset    @relation(fields: [assetId], references: [id])

  @@unique([assetId, poolRole])
  @@index([status, poolRole])
  @@map("safeguarding_policies")
}

model ReconciliationWarning {
  id             String          @id @default(uuid())
  warningNo      String          @unique @default("TEMP")
  runId          String
  businessDate   String
  assetId        String
  assetCode      String?
  warningType    String
  poolRole       String
  walletId       String?
  accountRef     String?
  observedValue  Decimal         @default(0)
  thresholdValue Decimal?
  status         String          @default("OPEN")
  detailsJson    String?
  detectedAt     DateTime        @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  run            SafeguardingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset          Asset           @relation(fields: [assetId], references: [id])
  wallet         Wallet?         @relation("ReconciliationWarningWallet", fields: [walletId], references: [id], onDelete: SetNull)

  @@index([runId, status])
  @@index([businessDate, status])
  @@index([assetId, poolRole, status])
  @@map("reconciliation_warnings")
}

model FiatStatementImport {
  id             String               @id @default(uuid())
  importNo       String               @unique @default("TEMP")
  runId          String?
  businessDate   String
  assetId        String
  walletId       String
  fileName       String
  status         String               @default("PENDING")
  closingBalance Decimal?
  parsedAt       DateTime?
  traceId        String?
  detailsJson    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  run            SafeguardingRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  asset          Asset                @relation(fields: [assetId], references: [id])
  wallet         Wallet               @relation("FiatStatementImportWallet", fields: [walletId], references: [id], onDelete: Cascade)
  entries        FiatStatementEntry[]

  @@index([businessDate, assetId, walletId])
  @@index([runId])
  @@map("fiat_statement_imports")
}

model FiatStatementEntry {
  id              String              @id @default(uuid())
  importId        String
  lineNo          Int
  valueDate       String?
  referenceNo     String?
  description     String?
  amount          Decimal             @default(0)
  balance         Decimal?
  rawRowJson      String
  createdAt       DateTime            @default(now())
  statementImport FiatStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, lineNo])
  @@index([importId, referenceNo])
  @@map("fiat_statement_entries")
}


model SumsubWebhookEvent {
  id                String    @id @default(cuid())
  eventNo           String    @unique
  eventType         String
  applicantId       String
  externalUserId    String
  context           String    @default("ONBOARDING")
  rawPayload        String
  receivedAt        DateTime
  status            String    @default("PENDING")
  retryCount        Int       @default(0)
  lastRetryAt       DateTime?
  lastErrorMessage  String?
  processedAt       DateTime?
  dispatchedTo      String?
  isSimulated       Boolean   @default(false)
  simulatedByUserId String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([applicantId])
  @@index([externalUserId])
  @@index([eventType, status])
  @@map("sumsub_webhook_events")
}

