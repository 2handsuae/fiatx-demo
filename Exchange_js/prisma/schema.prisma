}

model InternalFund {
  id                    String   @id @default(uuid())
  internalFundNo        String   @unique
  internalTransactionId String
  status                String
  assetId               String
  amount                Decimal
  feeAmount             Decimal  @default(0)
  netAmount             Decimal
  fromWalletId          String?
  fromAddress           String?
  fromIban              String?
  toWalletId            String?
  toAddress             String?
  toIban                String?
  txHash                String?
  confirmations         Int      @default(0)
  referenceNo           String?
  providerTxnId         String?
  nonce                 String?
  blockNo               String?
  gasUsed               String?
  effectiveGasPrice     String?
  sentAt                DateTime?
  confirmedAt           DateTime?
  completedAt           DateTime?
  statusHistory         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  internalTransaction   InternalTransaction @relation(fields: [internalTransactionId], references: [id], onDelete: Cascade)
  asset                 Asset    @relation(fields: [assetId], references: [id])
  fromWallet            Wallet?  @relation("InternalFundFromWallet", fields: [fromWalletId], references: [id])
  toWallet              Wallet?  @relation("InternalFundToWallet", fields: [toWalletId], references: [id])
  auditLogs             InternalFundAuditLog[]
  closedOutstandings    Outstanding[]

  @@index([internalTransactionId])
  @@index([status])
  @@index([txHash])
  @@index([createdAt])
  @@map("internal_funds")
}

model InternalTransactionAuditLog {
  id                    String   @id @default(uuid())
  internalTransactionId String
  operatorId            String
  oldStatus             String
  newStatus             String
  reason                String?
  createdAt             DateTime @default(now())
  internalTransaction   InternalTransaction @relation(fields: [internalTransactionId], references: [id], onDelete: Cascade)

  @@index([internalTransactionId])
  @@map("internal_transaction_audit_logs")
}

model InternalFundAuditLog {
  id            String   @id @default(uuid())
  internalFundId String
  operatorId    String
  oldStatus     String
  newStatus     String
  reason        String?
  createdAt     DateTime @default(now())
  internalFund  InternalFund @relation(fields: [internalFundId], references: [id], onDelete: Cascade)

  @@index([internalFundId])
  @@map("internal_fund_audit_logs")
}

model Coa {
  id                   String                @id @default(uuid())
  code                 String                @unique
  type                 String
  name                 String
  status               String
  requiredTags         String                @default("[]")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  journalLineTemplates JournalLineTemplate[]
  journalLines         JournalLine[]

  @@index([code])
  @@index([status])
  @@map("chart_of_accounts")
}

model Journal {
  id                      String                 @id @default(uuid())
  journalNo               String                 @unique @default("TEMP")
  sourceType              String
  sourceId                String
  sourceNo                String?
  eventCode               String
  postingStatus           String                 @default("POSTED")
  postedAt                DateTime?
  baseAssetId             String
  reversalOfJournalId     String?
  description             String?
  totalAmount             Decimal?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  journalHeaderTemplateId String?
  lines                   JournalLine[]
  baseAsset               Asset                  @relation("BaseAsset", fields: [baseAssetId], references: [id])
  journalHeaderTemplate   JournalHeaderTemplate? @relation(fields: [journalHeaderTemplateId], references: [id])

  @@index([sourceType, sourceId])
  @@index([sourceNo])
  @@index([eventCode])
  @@index([postingStatus])
  @@index([baseAssetId])
  @@index([createdAt])
  @@index([journalHeaderTemplateId])
  @@map("journals")
}

model JournalLine {
  id                    String               @id
  journalId             String
  lineNo                Int
  accountCode           String
  drCr                  String
  amount                Decimal
  assetId               String
  baseAmount            Decimal?
  fxRate                Decimal?
  ownerType             String?
  ownerId               String?
  walletId              String?
  dimensions            String               @default("{}")
  description           String?
  referenceId           String?
  journalLineTemplateId String?
  createdAt             DateTime             @default(now())
  journalLineTemplate   JournalLineTemplate? @relation(fields: [journalLineTemplateId], references: [id])
  journal               Journal              @relation(fields: [journalId], references: [id])
  account               Coa                  @relation(fields: [accountCode], references: [code])
  asset                 Asset                @relation(fields: [assetId], references: [id])
  wallet                Wallet?              @relation("JournalLineWallet", fields: [walletId], references: [id])
  walletBalanceEntry    WalletBalanceEntry?

  @@unique([journalId, lineNo])
  @@index([journalId])
  @@index([accountCode])
  @@index([assetId])
  @@index([ownerType, ownerId])
  @@index([accountCode, ownerType, ownerId])
  @@index([journalLineTemplateId])
  @@index([walletId])
  @@index([walletId, assetId])
  @@map("journal_lines")
}

model WalletBalanceSnapshot {
  id               String   @id @default(uuid())
  walletId         String
  assetId          String
  availableBalance Decimal  @default(0)
  restrictedBalance Decimal @default(0)
  inTransitBalance Decimal  @default(0)
  totalBalance     Decimal  @default(0)
  lastJournalLineId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  wallet           Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([walletId, assetId])
  @@index([walletId])
  @@index([assetId])
  @@map("wallet_balance_snapshots")
}

model WalletBalanceEntry {
  id               String   @id @default(uuid())
  journalLineId    String   @unique
  walletId         String
  assetId          String
  accountCode      String
  drCr             String
  amount           Decimal
  deltaAvailable   Decimal  @default(0)
  deltaRestricted  Decimal  @default(0)
  deltaInTransit   Decimal  @default(0)
  createdAt        DateTime @default(now())
  journalLine      JournalLine @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  wallet           Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([walletId, assetId])
  @@index([createdAt])
  @@map("wallet_balance_entries")
}

model AssetValuationRate {
  id             String   @id @default(uuid())
  assetId        String
