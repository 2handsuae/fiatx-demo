events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    # Upstream Definitions
    upstream admin_upstream {
        server 127.0.0.1:3001;
    }

    upstream client_upstream {
        server 127.0.0.1:3002;
    }

    upstream api_upstream {
        server 127.0.0.1:3000;
    }

    # Admin Portal Server
    server {
        listen       8081; # Public port for Admin
        server_name  admin.exchange.local;

        location / {
            proxy_pass http://admin_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # Proxy API requests if needed under same domain, or use CORS directly
        location /api/ {
            proxy_pass http://api_upstream/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }

    # Client Portal Server
    server {
        listen       8080; # Public port for Client
        server_name  exchange.local;

        location / {
            proxy_pass http://client_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
        
        location /api/ {
            proxy_pass http://api_upstream/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
