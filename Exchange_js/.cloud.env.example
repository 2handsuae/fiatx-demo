# 复制为 .cloud.env（本机、未入库）；按实际填写
# CLOUD_HOST：SSH 连的服务器公网 IP —— 部署走 IP，不依赖域名解析
CLOUD_HOST=101.32.141.97
CLOUD_USER=ubuntu
CLOUD_KEY=~/.ssh/exchange_demo_ed25519
# 对外访问的公网域名（Caddy 按域名自动发 Let's Encrypt 证书 + 路由到两个前端；两者都解析到上面的 IP）
CLOUD_ADMIN_HOST=admin-fiatx-demo.duckdns.org
CLOUD_CLIENT_HOST=fiatx-demo.duckdns.org
