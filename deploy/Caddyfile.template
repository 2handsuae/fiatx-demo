# deploy/Caddyfile.template — remote-apply.sh 把 __ADMIN_HOST__/__CLIENT_HOST__ 换成公网域名后装到 /etc/caddy/Caddyfile
# 域名证书：Let's Encrypt 正式目录，Caddy 首次加载即自动申请、90 天自动续（不再用 IP shortlived 档 / default_sni）
# acme_ca 只指 Let's Encrypt 一家，保持与上云时实测通过的一致
{
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(api_proxy) {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3000
	}
}

# 管理台
https://__ADMIN_HOST__ {
	import api_proxy
	handle {
		root * /opt/exchange-demo/web/admin
		try_files {path} /index.html
		file_server
	}
}

# 客户端
https://__CLIENT_HOST__ {
	import api_proxy
	handle {
		root * /opt/exchange-demo/web/client
		try_files {path} /index.html
		file_server
	}
}
